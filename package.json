{
  "name": "explainer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev:motion": "pnpm --filter @studio/motion-studio dev",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "checkpoints": "node scripts/checkpoints.mjs",
    "test:visual": "node scripts/visual.mjs",
    "render:preview": "node scripts/render-video.mjs preview",
    "render:master": "node scripts/render-video.mjs master",
    "check:media": "node scripts/check-media.mjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@fontsource-variable/inter": "5.3.0",
    "d3-scale": "4.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "2.1.9"
  }
}
